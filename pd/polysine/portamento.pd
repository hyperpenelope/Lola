#X obj 129 844 pack f 0;
#X obj 95 632 f 1;
#X text 93 536 the pitch should only enter the trigger object if it
is a note-on message;
#X obj 13 522 stripnote;
#X text 319 841 ramp if a note is currently on \; otherwise jump;
